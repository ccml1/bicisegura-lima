flowchart TB
  subgraph USR["Usuarios"]
    V["Visitante<br/>(consulta sin cuenta)"]
    C["Ciclista registrado<br/>(reporta y valida)"]
  end
  subgraph FE["Frontend · navegador"]
    UI["App web HTML/CSS/JS<br/>Mapa · Riesgo · Estadísticas · Cuenta"]
    GEO["Cerca de mí<br/>(distancia en el navegador)"]
  end
  subgraph EXT["Servicios externos"]
    OSM["OpenStreetMap<br/>mosaicos del mapa"]
    GPS["Geolocalización<br/>del navegador"]
  end
  subgraph API["Backend · API REST Node.js 22 + Express 5"]
    SEC["Seguridad transversal<br/>Helmet (CSP) · límite por IP · validación"]
    AUTH["Autenticación<br/>bcrypt + JWT"]
    EVT["Eventos<br/>reportar · votar · ya no está<br/>límite 10 reportes/h"]
    DOM["Reglas de dominio<br/>3 confirmaciones = verificado<br/>vencimiento por tipo"]
    EST["Estadísticas<br/>historial · semáforo · panel · calor<br/>(solo verificados)"]
  end
  DB[("PostgreSQL 16 · SQL parametrizado + SSL<br/>usuarios · distritos · eventos · votos · cierres")]
  MON["Monitoreo<br/>Application Insights"]
  V & C --> UI
  UI --> GEO
  GPS -.-> GEO
  OSM -.-> UI
  UI -- "HTTPS · JSON · Bearer JWT" --> SEC
  SEC --> AUTH & EVT & EST
  EVT --> DOM
  EST --> DOM
  AUTH & EVT & EST --> DB
  API -.-> MON
